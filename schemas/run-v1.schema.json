{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunWitness Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "adapters",
    "summary",
    "findings",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "diff": {
      "$ref": "#/$defs/diff"
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    }
  },
  "$defs": {
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "environment",
        "started_at",
        "finished_at",
        "duration_ms",
        "runner_version",
        "working_directory",
        "command",
        "process"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "process": {
          "$ref": "#/$defs/process"
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "git": {
          "$ref": "#/$defs/git"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "display": {
          "type": "string"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "type": ["integer", "null"]
        },
        "terminated_by_signal": {
          "type": ["string", "null"]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "branch": {
          "type": ["string", "null"]
        },
        "before": {
          "$ref": "#/$defs/git_state"
        },
        "after": {
          "$ref": "#/$defs/git_state"
        }
      }
    },
    "git_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "dirty"],
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40,64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "diff_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-zA-Z0-9_-]+:[0-9a-fA-F]+$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/uuidv7"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["ok", "unavailable", "error", "partial"]
        },
        "version": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "kind",
        "severity",
        "rule_id",
        "sources",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^rwf_[A-Za-z0-9._-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
        },
        "severity": {
          "enum": ["info", "warning", "error", "critical"]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "comparison_value": {
      "type": ["number", "integer", "string", "boolean", "null"]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "current"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/comparison_value"
        },
        "current": {
          "$ref": "#/$defs/comparison_value"
        },
        "delta": {
          "$ref": "#/$defs/comparison_value"
        },
        "delta_percent": {
          "type": ["number", "null"]
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "finding_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rwf_[A-Za-z0-9._-]+$"
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new", "resolved", "unchanged", "regressed", "improved"],
      "properties": {
        "new": {
          "$ref": "#/$defs/finding_id_list"
        },
        "resolved": {
          "$ref": "#/$defs/finding_id_list"
        },
        "unchanged": {
          "$ref": "#/$defs/finding_id_list"
        },
        "regressed": {
          "$ref": "#/$defs/finding_id_list"
        },
        "improved": {
          "$ref": "#/$defs/finding_id_list"
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gates"],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail", "error"]
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_result"
          }
        },
        "message": {
          "type": "string"
        }
      }
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "action", "outcome", "finding_ids"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": ["ignore", "warn", "fail"]
        },
        "outcome": {
          "enum": ["passed", "triggered", "skipped", "error"]
        },
        "finding_ids": {
          "$ref": "#/$defs/finding_id_list"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
