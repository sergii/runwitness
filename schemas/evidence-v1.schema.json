{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunWitness Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "run_id",
    "source",
    "kind",
    "observed_at",
    "attributes",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev_[A-Za-z0-9._-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
